<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Shop.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    app:cardBackgroundColor="@color/blanc"
    app:strokeColor="@color/gris_bordure"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:background="@color/rose_tres_clair">

            <androidx.media3.ui.PlayerView
                android:id="@+id/engagementPlayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:resize_mode="zoom"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <ImageView
                android:id="@+id/engagementPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/section_engagements"
                android:scaleType="centerCrop"
                android:src="@drawable/product_placeholder" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_section"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:id="@+id/txtEngagementTitle"
                style="@style/TextAppearance.Shop.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtEngagementDesc"
                style="@style/TextAppearance.Shop.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/texte_secondaire" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
