<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rose_pale"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_blue"
        android:title="@string/admin_order_manage"
        android:titleTextColor="@color/blanc" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_lg">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Shop.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/blanc"
                app:strokeColor="@color/gris_bordure"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtOrderNumber"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/playfair"
                            android:textColor="@color/bordeaux_fonce"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:paddingVertical="@dimen/spacing_xs"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtClient"
                        style="@style/TextAppearance.Shop.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textColor="@color/texte" />

                    <TextView
                        android:id="@+id/txtAddress"
                        style="@style/TextAppearance.Shop.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textColor="@color/texte_secondaire" />

                    <TextView
                        android:id="@+id/txtPhone"
                        style="@style/TextAppearance.Shop.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/texte_secondaire" />

                    <TextView
                        android:id="@+id/txtDate"
                        style="@style/TextAppearance.Shop.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textColor="@color/texte_secondaire" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.Shop.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:fontFamily="@font/playfair"
                android:text="@string/order_items_title"
                android:textColor="@color/bordeaux_fonce"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/txtTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:fontFamily="@font/poppins"
                android:gravity="end"
                android:textColor="@color/rouge"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TextAppearance.Shop.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/select_status"
                android:textColor="@color/texte_secondaire" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutStatus"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:hint="@string/select_status"
                app:boxCornerRadiusBottomEnd="@dimen/corner_card"
                app:boxCornerRadiusBottomStart="@dimen/corner_card"
                app:boxCornerRadiusTopEnd="@dimen/corner_card"
                app:boxCornerRadiusTopStart="@dimen/corner_card"
                app:boxStrokeColor="@color/shop_text_input_stroke"
                app:boxStrokeWidth="1.5dp"
                app:endIconTint="@color/bordeaux"
                app:hintTextColor="@color/bordeaux">

                <AutoCompleteTextView
                    android:id="@+id/spinnerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:inputType="none"
                    android:paddingVertical="@dimen/spacing_md"
                    android:textColor="@color/bordeaux_fonce"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Conservés (cachés) pour compat éventuelle -->
            <TextView
                android:id="@+id/txtCurrentStatus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/labelAgent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/spinnerAgent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyStatus"
                style="@style/Widget.Shop.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/btn_update_status" />

            <TextView
                style="@style/TextAppearance.Shop.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/timeline_title"
                android:textColor="@color/texte_secondaire" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
