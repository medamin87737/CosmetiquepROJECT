<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stateEmpty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:scaleType="centerCrop"
            android:src="@drawable/img_prod_01"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Shop.Circle"
            app:strokeColor="@color/bleu"
            app:strokeWidth="1dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:scaleType="centerCrop"
            android:src="@drawable/img_prod_02"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Shop.Circle"
            app:strokeColor="@color/rouge"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:scaleType="centerCrop"
            android:src="@drawable/img_prod_03"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Shop.Circle"
            app:strokeColor="@color/bleu"
            app:strokeWidth="1dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_prod_04"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Shop.Circle"
            app:strokeColor="@color/bleu"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtEmpty"
        style="@style/TextAppearance.Shop.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/state_empty"
        android:textAlignment="center"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtEmptyHint"
        style="@style/TextAppearance.Shop.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/state_empty_hint"
        android:textAlignment="center"
        android:textColor="@color/texte_secondaire" />
</LinearLayout>
