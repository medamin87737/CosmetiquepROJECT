<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rose_bebe"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Shop.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_blue"
        app:navigationIconTint="@color/blanc"
        app:title="@string/messages_title"
        app:titleTextColor="@color/blanc" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="88dp" />

        <include
            android:id="@+id/stateEmpty"
            layout="@layout/layout_state_empty" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewMessage"
            style="@style/Widget.Shop.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="@dimen/spacing_md"
            android:text="@string/btn_new_conversation"
            app:icon="@drawable/ic_message"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/spacing_sm"
            app:iconTint="@color/blanc" />
    </FrameLayout>
</LinearLayout>
