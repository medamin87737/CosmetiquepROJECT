<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Shop.Card"
    android:layout_width="match_parent"
    android:layout_height="@dimen/product_card_height"
    android:layout_margin="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_sm">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/product_card_image">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/content_desc_product_image"
                android:scaleType="centerCrop"
                android:src="@drawable/product_placeholder" />

            <TextView
                android:id="@+id/txtPromoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_margin="@dimen/spacing_sm"
                android:background="@drawable/bg_promo_badge"
                android:fontFamily="@font/poppins"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="@dimen/spacing_xs"
                android:text="@string/filter_promo"
                android:textColor="@color/blanc"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/txtProductName"
            style="@style/TextAppearance.Shop.Body"
            android:layout_width="match_parent"
            android:layout_height="@dimen/product_title_height"
            android:layout_marginHorizontal="@dimen/spacing_sm"
            android:layout_marginTop="@dimen/spacing_sm"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:gravity="top"
            android:maxLines="2"
            android:minLines="2"
            android:textColor="@color/texte"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtProductCategory"
            style="@style/TextAppearance.Shop.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_sm"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/texte_secondaire" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_sm"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtProductPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppins"
                android:maxLines="1"
                android:textColor="@color/rouge"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnAddCart"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_cart_circle"
                android:contentDescription="@string/add_to_cart"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_cart"
                android:tint="@color/blanc" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
