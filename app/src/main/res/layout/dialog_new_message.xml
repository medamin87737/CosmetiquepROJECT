<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/blanc"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar_circle"
            android:contentDescription="@string/btn_new_conversation"
            android:padding="8dp"
            android:src="@drawable/ic_message"
            android:tint="@color/bordeaux" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:fontFamily="@font/playfair"
            android:text="@string/btn_new_conversation"
            android:textColor="@color/bordeaux_fonce"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.Shop.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/new_message_hint"
        android:textColor="@color/texte_secondaire" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Shop.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        app:boxBackgroundMode="outline"
        app:startIconDrawable="@drawable/ic_message"
        app:startIconTint="@color/bordeaux">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:hint="@string/subject_hint"
            android:inputType="textCapSentences"
            android:maxLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="@string/btn_cancel_order"
            android:textColor="@color/texte_secondaire" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogSend"
            style="@style/Widget.Shop.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:minWidth="120dp"
            android:text="@string/btn_send"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/spacing_xs"
            app:iconTint="@color/blanc" />
    </LinearLayout>
</LinearLayout>
