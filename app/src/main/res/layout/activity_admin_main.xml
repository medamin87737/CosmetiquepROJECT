<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rose_pale">

    <!-- Contenu principal + flèche latérale centrée -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header : fond sous status bar, contenu sous heure / batterie -->
            <LinearLayout
                android:id="@+id/headerAdminRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_blue"
                android:orientation="vertical">

                <View
                    android:id="@+id/statusBarSpacer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent" />

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/adminToolbar"
                    style="@style/Widget.Shop.Toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/toolbar_height"
                    android:background="@android:color/transparent"
                    android:minHeight="@dimen/toolbar_height"
                    app:contentInsetStartWithNavigation="0dp"
                    app:navigationIcon="?attr/homeAsUpIndicator"
                    app:navigationIconTint="@color/blanc"
                    app:title="">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="@dimen/spacing_md">

                        <ImageView
                            android:id="@+id/imgToolbarLogo"
                            android:layout_width="@dimen/header_logo_size"
                            android:layout_height="@dimen/header_logo_size"
                            android:contentDescription="@string/app_name"
                            android:scaleType="fitCenter"
                            android:src="@drawable/logo_rose_mark" />

                        <TextView
                            android:id="@+id/txtToolbarTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppins"
                            android:maxLines="1"
                            android:text="@string/admin_dashboard"
                            android:textColor="@color/blanc"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.appbar.MaterialToolbar>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/adminFragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Flèche centrée verticalement : suit le bord de la sidebar -->
        <ImageButton
            android:id="@+id/btnSidebarToggle"
            android:layout_width="28dp"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_sidebar_toggle"
            android:contentDescription="@string/drawer_open"
            android:elevation="10dp"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/blanc" />
    </FrameLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/adminNavView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/blanc"
        app:headerLayout="@layout/nav_header_admin"
        app:menu="@menu/menu_admin_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
