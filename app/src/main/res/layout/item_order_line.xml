<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/bg_order_line"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_sm">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgOrderProduct"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/content_desc_product_image"
        android:scaleType="centerCrop"
        android:src="@drawable/product_placeholder"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Shop.Rounded12"
        app:strokeColor="@color/gris_bordure"
        app:strokeWidth="1dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtOrderItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="2"
            android:textColor="@color/texte"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtOrderItemQty"
            style="@style/TextAppearance.Shop.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/texte_secondaire" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtOrderItemUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins"
                android:textColor="@color/texte_secondaire"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/txtOrderItemTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textColor="@color/rouge"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
