<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <!-- Bande décor champagne en bas -->
    <View
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_gradient_champagne" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <ImageView
            android:id="@+id/imgSplashLogo"
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:contentDescription="@string/app_name"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_rose_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:fontFamily="@font/playfair"
            android:letterSpacing="0.02"
            android:text="@string/app_name"
            android:textColor="@color/bordeaux_fonce"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:fontFamily="@font/poppins"
            android:text="@string/header_tagline"
            android:textAlignment="center"
            android:textColor="@color/texte_secondaire"
            android:textSize="14sp" />

        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_gradient_champagne" />

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="@dimen/spacing_xl"
            android:indeterminateTint="@color/bordeaux" />
    </LinearLayout>
</FrameLayout>
