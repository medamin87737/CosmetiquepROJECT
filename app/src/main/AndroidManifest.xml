<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CosmetiqueApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.CosmetiqueShop">

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.CosmetiqueShop.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.LoginActivity" android:exported="false" />
        <activity android:name=".ui.auth.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.auth.ChangePasswordActivity" android:exported="false" />
        <activity android:name=".ui.publichome.PublicHomeActivity" android:exported="false" />
        <activity android:name=".ui.client.ClientMainActivity" android:exported="false" />
        <activity android:name=".ui.product.ProductDetailActivity" android:exported="false" />
        <activity android:name=".ui.checkout.CheckoutActivity" android:exported="false" />
        <activity android:name=".ui.order.OrderDetailActivity" android:exported="false" />
        <activity android:name=".ui.favorites.FavoritesActivity" android:exported="false" />
        <activity android:name=".ui.notifications.NotificationsActivity" android:exported="false" />
        <activity android:name=".ui.messages.MessagesActivity" android:exported="false" />
        <activity android:name=".ui.messages.ConversationActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminMainActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminProductEditActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminOrderManageActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminUserEditActivity" android:exported="false" />
        <activity
            android:name=".ui.assistant.BeautyAssistantActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>